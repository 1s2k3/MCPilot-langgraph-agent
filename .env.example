# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_platform

# ---- 安全 ----
# Fernet 主密钥：python scripts/gen_master_key.py 生成；未设置时 API Key 功能禁用
APP_MASTER_KEY=
# 可选网关鉴权令牌（设置后所有 API 需携带 X-Admin-Token 头）
ADMIN_TOKEN=

# ---- LLM ----
ANTHROPIC_API_KEY=
# 脚本化假 LLM（离线演示/评估回归）；未配置 API Key 时自动生效
SCRIPTED_LLM=false

# ---- Observability（LangSmith，可选）----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-platform
# Checkpoint 反序列化安全
LANGGRAPH_STRICT_MSGPACK=true

# ---- Memory ----
# local（默认，本地模型）/ disabled
EMBEDDING_PROVIDER=local

# ---- Web ----
CORS_ORIGINS=http://localhost:5173
